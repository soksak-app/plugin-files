{
  "id": "files",
  "name": "파일",
  "description": "프로젝트의 파일 트리와 즐겨찾기를 사이드바에 보여 준다. 카드 표면은 없다.",
  "sections": [
    {
      "id": "files.tree",
      "name": "파일 트리",
      "module": {
        "horizontal": "ui/sections/tree-horizontal.js",
        "vertical": "ui/sections/tree.js"
      },
      "fill": true
    },
    {
      "id": "files.bookmarks",
      "name": "북마크",
      "module": {
        "horizontal": "ui/sections/bookmarks-horizontal.js",
        "vertical": "ui/sections/bookmarks.js"
      }
    }
  ],
  "state": {
    "module": "ui/state.js"
  },
  "dependencies": {
    "@soksak/sidecar-files": ">=0.0.4"
  },
  "data": {
    "bookmarks": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": []
    }
  },
  "exposes": {
    "status": [
      {
        "name": "files.tree",
        "description": "The declared UI value: project-root status-line, toolbar buttons, the project tree with selection and git detail, and the no-project and empty-tree states.",
        "schema": {
          "type": "object",
          "properties": {
            "elements": {
              "type": "array"
            }
          }
        }
      },
      {
        "name": "files.bookmarks",
        "description": "The declared UI list of bookmarked project paths with removal commands and an empty-state label.",
        "schema": {
          "type": "object",
          "properties": {
            "elements": {
              "type": "array"
            }
          }
        }
      }
    ],
    "commands": [
      {
        "name": "files.refresh",
        "description": "Lists the project folder and every expanded directory again.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.tree.toggle",
        "description": "Expands a listed directory of the file tree, or folds it with its expanded subdirectories.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.bookmarks.add",
        "description": "Adds a path relative to the project folder to the bookmarks unless it is already there.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.bookmarks.remove",
        "description": "Removes a bookmarked path.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.select",
        "description": "Selects a path of the file tree, or clears the selection with null.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.open.failed",
        "description": "Records the failure to open a file from the file tree as files.open. The same text again changes nothing.",
        "params": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      }
    ],
    "dom": []
  },
  "events": "events.json"
}
