{
  "id": "files",
  "name": "파일",
  "description": "프로젝트의 파일 트리와 즐겨찾기를 사이드바에 보여 준다. 카드 표면은 없다.",
  "sections": [
    {
      "id": "files.tree",
      "name": "파일 트리",
      "composition": {
        "kind": "view",
        "page": "ui/tree.html"
      },
      "height": "fill"
    },
    {
      "id": "files.bookmarks",
      "name": "북마크",
      "composition": {
        "kind": "view",
        "page": "ui/bookmarks.html"
      },
      "height": 160
    }
  ],
  "dependencies": {
    "@soksak/sidecar-files": ">=0.0.8"
  },
  "data": {
    "bookmarks": {
      "schema": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": []
    }
  },
  "exposes": {
    "status": [],
    "commands": [
      {
        "name": "files.refresh",
        "description": "Lists the project folder and every expanded directory again.",
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.bookmarks.add",
        "description": "Adds a path relative to the project folder to the bookmarks unless it is already there.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.bookmarks.remove",
        "description": "Removes a bookmarked path.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.select",
        "description": "Selects a path of the file tree, or clears the selection with null.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.open",
        "description": "Opens a file of the project folder through core.file.open, which runs the plugin that declares the extension of the file.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.open.failed",
        "description": "Records the failure to open a file from the file tree as files.open. The same text again changes nothing.",
        "params": {
          "type": "object",
          "properties": {
            "error": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "null"
        }
      },
      {
        "name": "files.tree.toggle",
        "description": "Expands or collapses a folder of the file tree: the sidecar lists the folder or stops listing it, and the tree shows its reply. expanded is the state that the tree library shows.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "expanded": {
              "type": "boolean"
            }
          }
        },
        "result": {
          "type": "null"
        }
      }
    ],
    "dom": []
  },
  "events": "events.json"
}
