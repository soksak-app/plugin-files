{
  "schema": 3,
  "layers": [
    "plugin"
  ],
  "events": {
    "plugin.files.tree.request": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug",
        "warn"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "operation": {
            "type": "string"
          },
          "ok": {
            "type": "boolean"
          },
          "micros": {
            "type": "number"
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "operation",
          "ok",
          "micros"
        ]
      },
      "description": "One tree request of the file tree view to the files sidecar (snapshot, expand, collapse or select) and its result; error is the text of the failure and the level is warn for a failed request."
    },
    "plugin.files.tree.changed": {
      "layer": "plugin",
      "class": "io",
      "level": "debug",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "description": "The files sidecar reported a change in a watched directory; path is the changed directory relative to the project folder."
    },
    "plugin.files.tree.failed": {
      "layer": "plugin",
      "class": "io",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "description": "The files sidecar reported a failure that no request caused; error is its text."
    },
    "plugin.files.open.failed": {
      "layer": "plugin",
      "class": "call",
      "level": "warn",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "description": "A file of the tree did not open; error is the refusal that the message row shows."
    },
    "plugin.files.tree.reply.earlier": {
      "layer": "plugin",
      "class": "call",
      "level": [
        "debug"
      ],
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      },
      "description": "A reply of the files sidecar to a request of an earlier document of the surface, which the reloaded view does not wait for."
    },
    "plugin.files.view.content_frame": {
      "layer": "plugin",
      "class": "frame",
      "level": "trace",
      "fields": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "documentTimeOriginMs": {
            "type": "number",
            "minimum": 0
          },
          "firstResizeAtMs": {
            "type": "number",
            "minimum": 0
          },
          "resizeAtMs": {
            "type": "number",
            "minimum": 0
          },
          "resizeCount": {
            "type": "integer",
            "minimum": 1
          },
          "frameTimeMs": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "sequence",
          "width",
          "height",
          "documentTimeOriginMs",
          "firstResizeAtMs",
          "resizeAtMs",
          "resizeCount",
          "frameTimeMs"
        ]
      },
      "description": "The size of the root of a section view document at the animation frame after its resize, while files.view.frames is started: the first and latest resize times, their count and the frame time, in the clock of the view document. It records a size, not a presentation on the display."
    }
  }
}
